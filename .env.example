# Conexión a PostgreSQL.
# Si usas Docker: postgresql://postgres:TU_PASSWORD@localhost:5432/inversiones_w
# Si usas el PostgreSQL nativo de Windows, es la misma forma.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/inversiones_w"

# Secreto para firmar cookies de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-bytes-en-hex"