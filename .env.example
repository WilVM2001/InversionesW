# ============================================================================
# Variables de entorno. Copia este archivo como ".env" y llena los valores.
# En Vercel se configuran en Project -> Settings -> Environment Variables.
# ============================================================================

# --- Opcion 1: Supabase (produccion) ----------------------------------------
# Supabase entrega DOS cadenas. Usar cada una en su lugar:
#
# DATABASE_URL  -> Connection Pooling, Transaction mode, puerto 6543.
#                  La usa la aplicacion. Agregar ?pgbouncer=true
# DIRECT_URL    -> Connection String directa, puerto 5432.
#                  Solo la usan las migraciones (prisma migrate deploy).
#
# DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Opcion 2: PostgreSQL local (desarrollo) --------------------------------
# Docker o servicio nativo, normalmente en el puerto 5432.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/inversiones_w"

# Secreto para firmar cookies de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-bytes-en-hex"

# Credenciales del administrador que crea el seed (opcionales).
# Si no se definen, el seed genera una contrasena temporal al azar.
# SEED_ADMIN_EMAIL="admin@inversionesw.co"
# SEED_ADMIN_PASSWORD="una-contrasena-fuerte"
